# Non-secret development defaults for the Base44 sandbox stack.
#
# Listed FIRST in docker-compose.base44.yml so that anything in
# /run/base44/app.env (platform-delivered secrets) overrides it.
#
# Nothing here is a credential.

NODE_ENV=development
LOG_LEVEL=dev

# The sandbox preview is served over HTTPS, so session cookies are marked Secure.
# For plain-HTTP local development set COOKIE_SECURE=0 (see .env.example).
COOKIE_SECURE=1
SESSION_COOKIE_NAME=cv_session
JWT_TTL_DAYS=7

# Real client IPs arrive through the preview proxy.
TRUST_PROXY=1

# No real payment gateway is configured: checkout runs in clearly-labelled
# sandbox mode and never charges a card.
PAYMENT_PROVIDER=sandbox
PAYMENT_SANDBOX_ENABLED=1
