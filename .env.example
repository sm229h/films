# CineVerse — نمونه متغیرهای محیطی
# این فایل فقط نمونه است. هیچ مقدار واقعی یا Secret در آن قرار ندهید.
# فایل واقعی را با نام `.env` بسازید (در .gitignore نادیده گرفته می‌شود).

# ---------------------------------------------------------------- پایه
NODE_ENV=development
PORT=8000
LOG_LEVEL=dev

# ------------------------------------------------------------- دیتابیس
DATABASE_URL=postgres://cineverse:cineverse@localhost:5432/cineverse

# -------------------------------------------------- نشست و امنیت
# کلید امضای توکن نشست. مقدار تصادفی و بلند تولید کنید:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_TTL_DAYS=7
SESSION_COOKIE_NAME=cv_session
# اگر سایت روی HTTPS اجرا می‌شود ۱ و در محیط HTTP محلی ۰ باشد.
COOKIE_SECURE=0
# پشت پروکسی معکوس ۱ باشد تا IP واقعی در محدودیت نرخ لحاظ شود.
TRUST_PROXY=1

# --------------------------------------------------------- CORS
# فقط دامنه‌های مجاز را بنویسید (با کاما جدا شوند). خالی = فقط همان مبدا.
CORS_ORIGINS=http://localhost:5173

# ------------------------------------- ارائه‌دهنده اطلاعات فیلم (اختیاری)
# بدون این کلید، سایت با داده‌های نمونه کار می‌کند و هیچ درخواستی به سرویس
# بیرونی فرستاده نمی‌شود. کلید فقط در بک‌اند نگهداری می‌شود.
TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3

# ------------------------------------------------------------ پرداخت
# 'sandbox' یعنی درگاه واقعی وصل نیست و پرداخت آزمایشی است.
PAYMENT_PROVIDER=sandbox
PAYMENT_SANDBOX_ENABLED=1

# -------------------------------------------- حساب‌های نمونه هنگام Seed
SEED_ADMIN_EMAIL=admin@cineverse.local
SEED_ADMIN_PASSWORD=
SEED_USER_EMAIL=user@cineverse.local
SEED_USER_PASSWORD=
